{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidera-ui",
  "compatibility_date": "2025-03-01",
  "routes": [
    {
      "pattern": "sidera.devwanna.tech",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
